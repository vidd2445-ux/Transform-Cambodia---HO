# Copy these values to your local .env file or to Render's environment settings.
# Never commit real credentials to GitHub.
SECRET_KEY=replace-with-a-long-random-secret
TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
TELEGRAM_BOT_USERNAME=TransformCambodiastaff_bot
DATA_DIR=/var/data

# Optional email fallback settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional Google sign-in settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
